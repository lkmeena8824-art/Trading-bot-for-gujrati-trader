# ===== CORE TELEGRAM / RUNTIME =====
BOT_TOKEN=
FREE_CHANNEL_ID=0
VIP_CHANNEL_ID=0
ADMIN_IDS=
DATABASE_PATH=./data/bot.db
PORT=8080

# Optional webhook protection
WEBHOOK_SECRET=

# ===== ZERO-COST DEFAULTS =====
AI_ENABLED=false
DATA_PROVIDER=free
SIGNAL_SYMBOL=NIFTY
AUTO_TRADE_CHANNEL=FREE
MAX_DAILY_TRADES=3

# ===== OPTIONAL FREE-DATA TUNING =====
GIFT_NIFTY_TICKER=^NSEI
DATA_TIMEOUT_SECONDS=12
DATA_MAX_AGE_SECONDS=180
OPTION_CHAIN_MIN_INTERVAL_SECONDS=60
CANDLE_MIN_INTERVAL_SECONDS=45

# ===== PHASE 2: OPTIONAL AI WORDING LAYER =====
# AI is a wording layer only. It can never decide BUY/SELL and can never change
# entry, SL, targets, RRR, OI or P&L numbers. Leave AI_ENABLED=false for the
# fully free deterministic mode.
# AI_PROVIDER: openai | gemini | auto | none  ("auto" prefers OpenAI, then Gemini)
AI_PROVIDER=openai

# OpenAI (billed separately by OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (billed separately by Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AI safety / spend controls
AI_MIN_INTERVAL_SECONDS=15
AI_TIMEOUT_SECONDS=8
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.3
AI_DAILY_CALL_BUDGET=200
AI_PERSONA_NAME=Sniper Bhai
# hinglish | english | gujarati
AI_STYLE_LANGUAGE=hinglish

# ===== PHASE 2: CONTEXTUAL HUMAN-STYLE REPLIES =====
# These work with AI_ENABLED=false too (deterministic templates).
REPLY_ENABLED=true
REPLY_COOLDOWN_SECONDS=20
REPLY_MAX_PER_USER_PER_DAY=15
# Reply inside Free/VIP groups only when the bot is mentioned or replied to.
REPLY_IN_GROUPS=false

# ===== PHASE 2: MEMORY =====
COMMUNITY_MEMORY_ENABLED=true
POLL_TRACKING_ENABLED=true
MARKET_MEMORY_DAYS=5
